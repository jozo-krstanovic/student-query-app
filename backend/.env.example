APP_NAME="Student Query App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# php artisan serve is single-threaded by default -- without this, concurrent
# requests (e.g. the admin panel's parallel fetches) queue up serially, each
# paying the remote DB's connection/query latency on top of the last.
PHP_CLI_SERVER_WORKERS=4

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# From Supabase: Project Settings -> Database -> Connection string -> URI
# Use the Transaction pooler string (port 6543) for a normal PHP web app.
DB_CONNECTION=pgsql
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.xxxxxxxxxxxx
DB_PASSWORD=your-database-password
DB_SSLMODE=require

# From Supabase: Project Settings -> API -> Project URL.
# Used to fetch the project's public JWKS for verifying auth tokens -- not a secret.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# From Supabase: Project Settings -> API -> service_role secret key. Grants
# full access bypassing RLS -- never expose to the frontend. Used to read/write
# Supabase Storage objects for document uploads (Storage isn't proxied through
# Postgres/PostgREST, so this is separate from the DB_* credentials above).
SUPABASE_SERVICE_ROLE_KEY=

# Must be created manually in the Supabase dashboard first (Storage -> New
# bucket -> private) -- Storage buckets aren't managed by the SQL migrations
# in supabase/migrations/.
SUPABASE_STORAGE_BUCKET=inquiry-documents

# The API is stateless (bearer-token auth, no cookies/sessions), so these stay
# off any database-backed driver -- no unrelated Laravel bookkeeping tables
# alongside the real domain schema, which Supabase CLI migrations own exclusively.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# CORS: origin allowed to call this API (see config/cors.php)
FRONTEND_URL=http://localhost:5173

# Sail: host port the laravel.test container's port 80 is published on.
APP_PORT=8000
