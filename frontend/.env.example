# Copy this file to .env and fill in your real Supabase values.
# .env is gitignored -- but note VITE_ vars are still bundled into client-side
# JS at build time, so only ever put the anon/publishable key here, never a
# service role or secret key.

# From Supabase: Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# From Supabase: Project Settings -> API -> Publishable key (anon)
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Laravel backend base URL (defaults to this if unset)
VITE_API_BASE_URL=http://localhost:8000

# Laravel Reverb (real-time notifications) -- APP_KEY must match the
# backend's REVERB_APP_KEY (backend/.env). This key is public by design,
# unlike REVERB_APP_SECRET which stays backend-only.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
